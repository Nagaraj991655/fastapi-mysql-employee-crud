pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                rsync -rltDzv --delete \
                --exclude=.git \
                $WORKSPACE/ \
                /home/ubuntu/fastapi-mysql-employee-crud/

                cd /home/ubuntu/fastapi-mysql-employee-crud

                docker compose down || true

                docker compose build

                docker compose up -d
                '''
            }
        }

        stage('Verify') {
            steps {
                sh '''
                docker ps
                '''
            }
        }
    }

    post {
        success {
            echo 'Deployment Successful!'
        }

        failure {
            echo 'Deployment Failed!'
        }
    }
}
