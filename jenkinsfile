pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                git config --global --add safe.directory /home/ubuntu/fastapi-mysql-employee-crud || true

                cd /home/ubuntu/fastapi-mysql-employee-crud

                git pull origin main

                docker compose down

                docker compose build

                docker compose up -d
                '''
            }
        }

        stage('Verify') {
            steps {
                sh '''
                docker ps
                '''
            }
        }
    }

    post {
        success {
            echo 'Deployment Successful!'
        }

        failure {
            echo 'Deployment Failed!'
        }
    }
}

